{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hexy Endpoint",
  "version": "0.1.9",
  "identifier": "com.dimtar.hexy-endpoint",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Hexy Endpoint",
        "width": 460,
        "height": 700,
        "minWidth": 380,
        "minHeight": 480,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "macOS": {
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "cifs-utils",
          "pkexec | policykit-1"
        ],
        "files": {
          "/usr/lib/hexy-endpoint/hexy-endpoint-mount-helper": "target/release/hexy-endpoint-mount-helper",
          "/usr/share/polkit-1/actions/com.dimtar.hexy-endpoint.policy": "linux/com.dimtar.hexy-endpoint.policy"
        }
      },
      "rpm": {
        "depends": [
          "cifs-utils",
          "polkit"
        ],
        "files": {
          "/usr/lib/hexy-endpoint/hexy-endpoint-mount-helper": "target/release/hexy-endpoint-mount-helper",
          "/usr/share/polkit-1/actions/com.dimtar.hexy-endpoint.policy": "linux/com.dimtar.hexy-endpoint.policy"
        }
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Dimtar/hexy-endpoint/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQzNjUzQjdEOUJBRTZDQTcKUldTbmJLNmJmVHRsUTkyR1F2MVlhNmlRVzF2U1AybkRvVmEzVGoydVdYKzVCcnRGRjVEM2krOGoK"
    }
  }
}
